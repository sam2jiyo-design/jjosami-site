{
  "name": "jjosami-site",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.10.0",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "pnpm --filter @jjosami/web dev",
    "build": "pnpm --filter @jjosami/web build",
    "check": "pnpm -r typecheck",
    "release": "node scripts/release.mjs",
    "collector:check": "pnpm --filter @jjosami/collector build"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.3.14",
    "@types/node": "22.15.3",
    "esbuild": "0.28.1",
    "fflate": "0.8.2",
    "postcss": "8.5.6",
    "tsx": "4.20.5",
    "typescript": "5.9.3"
  }
}
